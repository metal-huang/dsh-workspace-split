{
  "name": "@metal-huang/dsh-workspace-split",
  "version": "0.1.2",
  "description": "Split view for DeepSeek Harness: keep several live sessions side by side, each one typable.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "split-view",
    "dashboard",
    "multi-session"
  ],
  "homepage": "https://github.com/metal-huang/dsh-workspace-split#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metal-huang/dsh-workspace-split.git"
  },
  "bugs": {
    "url": "https://github.com/metal-huang/dsh-workspace-split/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "katex": "^0.18.11",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-file-upload"
      ]
    }
  }
}
